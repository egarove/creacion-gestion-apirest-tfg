<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Master Console - API Generator</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --bg: #0f172a;
            --card-bg: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border: #334155;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Outfit', sans-serif; background-color: var(--bg); color: var(--text-main); }

        .sidebar { width: 280px; background: var(--card-bg); height: 100vh; position: fixed; border-right: 1px solid var(--border); padding: 2rem; }
        .main-content { margin-left: 280px; padding: 3rem; min-height: 100vh; }

        .logo { font-size: 1.5rem; font-weight: 700; color: white; display: flex; align-items: center; gap: 0.75rem; margin-bottom: 3rem; }
        .logo i { color: var(--primary); }

        .nav-link { display: flex; align-items: center; gap: 1rem; padding: 1rem; color: var(--text-muted); text-decoration: none; border-radius: 0.75rem; transition: all 0.2s; margin-bottom: 0.5rem; }
        .nav-link:hover, .nav-link.active { background: rgba(79, 70, 229, 0.1); color: white; }
        .nav-link.active i { color: var(--primary); }

        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem; }
        .header h2 { font-size: 2rem; font-weight: 700; }

        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 1.5rem; }
        .api-card { background: var(--card-bg); border-radius: 1.25rem; border: 1px solid var(--border); padding: 2rem; transition: all 0.3s; }
        .api-card:hover { transform: translateY(-5px); border-color: var(--primary); box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5); }

        .api-header { display: flex; justify-content: space-between; margin-bottom: 1.5rem; }
        .status-badge { padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
        .status-running { background: rgba(16, 185, 129, 0.1); color: var(--success); }
        .status-stopped { background: rgba(239, 68, 68, 0.1); color: var(--danger); }

        .api-name { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; }
        .api-info { color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1.5rem; display: flex; gap: 1rem; }

        .actions { display: flex; gap: 0.75rem; }
        .btn { flex: 1; padding: 0.75rem; border-radius: 0.75rem; border: 1px solid var(--border); background: transparent; color: white; cursor: pointer; transition: all 0.2s; font-family: inherit; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 0.5rem; text-decoration: none; }
        .btn-primary { background: var(--primary); border: none; }
        .btn-primary:hover { background: var(--primary-hover); }
        .btn-outline:hover { background: var(--border); }

        .empty-state { grid-column: 1 / -1; text-align: center; padding: 5rem; background: var(--card-bg); border-radius: 1.25rem; border: 2px dashed var(--border); }
        
        .toast { position: fixed; bottom: 2rem; right: 2rem; background: var(--primary); color: white; padding: 1rem 2rem; border-radius: 1rem; display: none; z-index: 1000; animation: slideIn 0.3s; }
        @keyframes slideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo">
            <i class="fas fa-layer-group"></i>
            <span>APIGen Master</span>
        </div>
        <nav>
            <a href="#" class="nav-link active"><i class="fas fa-th-large"></i> Dashboard</a>
            <a href="#" class="nav-link"><i class="fas fa-server"></i> Infraestructura</a>
            <a href="#" class="nav-link"><i class="fas fa-cog"></i> Ajustes</a>
        </nav>
    </div>

    <div class="main-content">
        <div class="header">
            <div>
                <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.5rem;">Bienvenido de nuevo, Administrador</p>
                <h2>Panel de Control</h2>
            </div>
            <button class="btn btn-primary" onclick="location.reload()" style="flex: none; padding: 0.75rem 1.5rem;">
                <i class="fas fa-sync-alt"></i> Refrescar
            </button>
        </div>

        <div class="grid" id="apiGrid">
            <!-- APIs se cargarán dinámicamente -->
        </div>
    </div>

    <div id="toast" class="toast">Mensaje del sistema</div>

    <script>
        async function fetchApis() {
            try {
                // Obtenemos el registro de la base de datos maestra
                const response = await fetch('/get-all-apis'); 
                const apis = await response.json();
                renderApis(apis);
            } catch (e) {
                console.error("Error al cargar APIs", e);
            }
        }

        function renderApis(apis) {
            const grid = document.getElementById('apiGrid');
            if (apis.length === 0) {
                grid.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-plus-circle" style="font-size: 3rem; color: var(--border); margin-bottom: 1rem;"></i>
                        <h3>No hay APIs creadas</h3>
                        <p style="color: var(--text-muted)">Usa la App móvil para generar tu primera API.</p>
                    </div>`;
                return;
            }

            grid.innerHTML = apis.map(api => `
                <div class="api-card">
                    <div class="api-header">
                        <span class="status-badge ${api.status === 'running' ? 'status-running' : 'status-stopped'}">
                            ${api.status || 'unknown'}
                        </span>
                        <i class="fas fa-ellipsis-h" style="color: var(--text-muted); cursor: pointer;"></i>
                    </div>
                    <h3 class="api-name">${api.api_name}</h3>
                    <div class="api-info">
                        <span><i class="fas fa-network-wired"></i> Puerto: ${api.port}</span>
                        <span><i class="fas fa-database"></i> ${api.db}</span>
                    </div>
                    <div class="actions">
                        <a href="http://${window.location.hostname}:${api.port}/ui" target="_blank" class="btn btn-primary">
                            <i class="fas fa-external-link-alt"></i> Panel
                        </a>
                        <button onclick="toggleApi('${api.api_name}', '${api.status}')" class="btn btn-outline">
                            <i class="fas ${api.status === 'running' ? 'fa-stop' : 'fa-play'}"></i>
                            ${api.status === 'running' ? 'Detener' : 'Iniciar'}
                        </button>
                        <button onclick="deleteApi('${api.api_name}')" class="btn btn-outline" style="color: var(--danger);">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        async function toggleApi(name, currentStatus) {
            const action = currentStatus === 'running' ? 'stop' : 'start';
            await fetch(\`/${name}/${action}\`, {method: 'POST'});
            showToast(\`API ${{name}} ${{action === 'stop' ? 'detenida' : 'iniciada'}}\`);
            fetchApis();
        }

        async function deleteApi(name) {
            if (!confirm(\`¿Estás seguro de eliminar permanentemente la API ${{name}}?\`)) return;
            await fetch(\`/${name}/delete\`, {method: 'POST'});
            showToast(\`API ${{name}} eliminada\`);
            fetchApis();
        }

        function showToast(msg) {
            const t = document.getElementById('toast');
            t.innerText = msg;
            t.style.display = 'block';
            setTimeout(() => t.style.display = 'none', 3000);
        }

        fetchApis();
        // Polling para refrescar estados cada 10 segundos
        setInterval(fetchApis, 10000);
    </script>
</body>
</html>
