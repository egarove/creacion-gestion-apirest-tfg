#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <microhttpd.h>
#include <cjson/cJSON.h>
{% if db == 'postgresql' %}
#include <libpq-fe.h>
{% elif db in ['mysql', 'mariadb'] %}
#include <mysql/mysql.h>
{% elif db == 'sqlite' %}
#include <sqlite3.h>
{% endif %}

#define PORT 8000
#define MAX_FIELDS 64

{% if db == 'postgresql' %}
static PGconn *db_conn = NULL;

void init_db() {
    const char *url = getenv("DATABASE_URL");
    db_conn = PQconnectdb(url);
    if (PQstatus(db_conn) != CONNECTION_OK) {
        fprintf(stderr, "Error conexion BD: %s\n", PQerrorMessage(db_conn));
        exit(1);
    }
}
{% elif db in ['mysql', 'mariadb'] %}
static MYSQL *db_conn = NULL;

void init_db() {
    const char *url = getenv("DATABASE_URL");
    db_conn = mysql_init(NULL);
    /* Parsear DATABASE_URL simplificado: user:pass@host:port/dbname */
    char user[64], pass[64], host[128], dbname[64];
    int port = 3306;
    sscanf(url, "%*[^/]//%63[^:]:%63[^@]@%127[^:]:%d/%63s", user, pass, host, &port, dbname);
    if (!mysql_real_connect(db_conn, host, user, pass, dbname, port, NULL, 0)) {
        fprintf(stderr, "Error conexion BD: %s\n", mysql_error(db_conn));
        exit(1);
    }
}
{% elif db == 'sqlite' %}
static sqlite3 *db_conn = NULL;

void init_db() {
    const char *url = getenv("DATABASE_URL");
    const char *path = url;
    if (strncmp(url, "sqlite:///", 10) == 0) path = url + 10;
    if (sqlite3_open(path, &db_conn) != SQLITE_OK) {
        fprintf(stderr, "Error abriendo BD: %s\n", sqlite3_errmsg(db_conn));
        exit(1);
    }
}
{% endif %}

static char *json_root = "{\"status\":\"online\",\"api\":\"{{ api_name }}\"}";

struct PostData {
    char *data;
    size_t size;
};

/* ── Helper: ejecutar INSERT desde JSON body ── */
static char *do_insert(const char *body) {
    if (!body || !*body) return strdup("{\"error\":\"empty body\"}");
    cJSON *json = cJSON_Parse(body);
    if (!json) return strdup("{\"error\":\"invalid json\"}");

    int n = cJSON_GetArraySize(json);
    if (n == 0 || n > MAX_FIELDS) { cJSON_Delete(json); return strdup("{\"error\":\"bad fields\"}"); }

    char cols[2048] = "";
    char vals[4096] = "";
    {% if db == 'postgresql' %}
    const char *paramValues[MAX_FIELDS];
    char paramBufs[MAX_FIELDS][512];
    {% endif %}
    int idx = 0;

    cJSON *item = NULL;
    cJSON_ArrayForEach(item, json) {
        if (idx > 0) { strcat(cols, ", "); strcat(vals, ", "); }
        strcat(cols, item->string);
        {% if db == 'postgresql' %}
        char ph[16]; snprintf(ph, sizeof(ph), "$%d", idx + 1);
        strcat(vals, ph);
        if (cJSON_IsNumber(item)) snprintf(paramBufs[idx], 512, "%g", item->valuedouble);
        else if (cJSON_IsString(item)) snprintf(paramBufs[idx], 512, "%s", item->valuestring);
        else snprintf(paramBufs[idx], 512, "%s", cJSON_PrintUnformatted(item));
        paramValues[idx] = paramBufs[idx];
        {% elif db in ['mysql', 'mariadb'] %}
        char escaped[1024];
        if (cJSON_IsString(item)) {
            char tmp[512]; mysql_real_escape_string(db_conn, tmp, item->valuestring, strlen(item->valuestring));
            snprintf(escaped, sizeof(escaped), "'%s'", tmp);
        } else if (cJSON_IsNumber(item)) {
            snprintf(escaped, sizeof(escaped), "%g", item->valuedouble);
        } else {
            snprintf(escaped, sizeof(escaped), "NULL");
        }
        strcat(vals, escaped);
        {% endif %}
        idx++;
    }

    char sql[8192];
    snprintf(sql, sizeof(sql), "INSERT INTO data_{{ api_name }} (%s) VALUES (%s)", cols, vals);

    char *result;
    {% if db == 'postgresql' %}
    PGresult *res = PQexecParams(db_conn, sql, idx, NULL, paramValues, NULL, NULL, 0);
    if (PQresultStatus(res) != PGRES_COMMAND_OK) {
        char err[1024]; snprintf(err, sizeof(err), "{\"error\":\"%s\"}", PQerrorMessage(db_conn));
        result = strdup(err);
    } else {
        result = strdup("{\"msg\":\"inserted\"}");
    }
    PQclear(res);
    {% elif db in ['mysql', 'mariadb'] %}
    if (mysql_query(db_conn, sql) != 0) {
        char err[1024]; snprintf(err, sizeof(err), "{\"error\":\"%s\"}", mysql_error(db_conn));
        result = strdup(err);
    } else {
        result = strdup("{\"msg\":\"inserted\"}");
    }
    {% elif db == 'sqlite' %}
    char *errmsg = NULL;
    if (sqlite3_exec(db_conn, sql, NULL, NULL, &errmsg) != SQLITE_OK) {
        char err[1024]; snprintf(err, sizeof(err), "{\"error\":\"%s\"}", errmsg ? errmsg : "sqlite error");
        if (errmsg) sqlite3_free(errmsg);
        result = strdup(err);
    } else {
        result = strdup("{\"msg\":\"inserted\"}");
    }
    {% endif %}
    cJSON_Delete(json);
    return result;
}

/* ── Helper: ejecutar UPDATE desde JSON body ── */
static char *do_update(const char *body) {
    if (!body || !*body) return strdup("{\"error\":\"empty body\"}");
    cJSON *json = cJSON_Parse(body);
    if (!json) return strdup("{\"error\":\"invalid json\"}");

    cJSON *id_item = cJSON_GetObjectItem(json, "id");
    if (!id_item) { cJSON_Delete(json); return strdup("{\"error\":\"id required\"}"); }

    char id_str[64];
    if (cJSON_IsNumber(id_item)) snprintf(id_str, sizeof(id_str), "%d", id_item->valueint);
    else if (cJSON_IsString(id_item)) snprintf(id_str, sizeof(id_str), "%s", id_item->valuestring);
    else { cJSON_Delete(json); return strdup("{\"error\":\"invalid id\"}"); }

    char sets[4096] = "";
    {% if db == 'postgresql' %}
    const char *paramValues[MAX_FIELDS];
    char paramBufs[MAX_FIELDS][512];
    {% endif %}
    int idx = 0;

    cJSON *item = NULL;
    cJSON_ArrayForEach(item, json) {
        if (strcmp(item->string, "id") == 0) continue;
        if (idx > 0) strcat(sets, ", ");
        {% if db == 'postgresql' %}
        char clause[256]; snprintf(clause, sizeof(clause), "%s = $%d", item->string, idx + 1);
        strcat(sets, clause);
        if (cJSON_IsNumber(item)) snprintf(paramBufs[idx], 512, "%g", item->valuedouble);
        else if (cJSON_IsString(item)) snprintf(paramBufs[idx], 512, "%s", item->valuestring);
        else snprintf(paramBufs[idx], 512, "%s", cJSON_PrintUnformatted(item));
        paramValues[idx] = paramBufs[idx];
        {% elif db in ['mysql', 'mariadb'] %}
        char escaped[1024];
        if (cJSON_IsString(item)) {
            char tmp[512]; mysql_real_escape_string(db_conn, tmp, item->valuestring, strlen(item->valuestring));
            snprintf(escaped, sizeof(escaped), "%s = '%s'", item->string, tmp);
        } else if (cJSON_IsNumber(item)) {
            snprintf(escaped, sizeof(escaped), "%s = %g", item->string, item->valuedouble);
        } else {
            snprintf(escaped, sizeof(escaped), "%s = NULL", item->string);
        }
        strcat(sets, escaped);
        {% endif %}
        idx++;
    }

    if (idx == 0) { cJSON_Delete(json); return strdup("{\"error\":\"no fields to update\"}"); }

    char sql[8192];
    char *result;
    {% if db == 'postgresql' %}
    snprintf(sql, sizeof(sql), "UPDATE data_{{ api_name }} SET %s WHERE id = $%d", sets, idx + 1);
    paramValues[idx] = id_str;
    PGresult *res = PQexecParams(db_conn, sql, idx + 1, NULL, paramValues, NULL, NULL, 0);
    if (PQresultStatus(res) != PGRES_COMMAND_OK) {
        char err[1024]; snprintf(err, sizeof(err), "{\"error\":\"%s\"}", PQerrorMessage(db_conn));
        result = strdup(err);
    } else {
        result = strdup("{\"msg\":\"updated\"}");
    }
    PQclear(res);
    {% elif db in ['mysql', 'mariadb'] %}
    char escaped_id[128]; mysql_real_escape_string(db_conn, escaped_id, id_str, strlen(id_str));
    snprintf(sql, sizeof(sql), "UPDATE data_{{ api_name }} SET %s WHERE id = '%s'", sets, escaped_id);
    if (mysql_query(db_conn, sql) != 0) {
        char err[1024]; snprintf(err, sizeof(err), "{\"error\":\"%s\"}", mysql_error(db_conn));
        result = strdup(err);
    } else {
        result = strdup("{\"msg\":\"updated\"}");
    }
    {% elif db == 'sqlite' %}
    snprintf(sql, sizeof(sql), "UPDATE data_{{ api_name }} SET %s WHERE id = '%s'", sets, id_str);
    char *errmsg = NULL;
    if (sqlite3_exec(db_conn, sql, NULL, NULL, &errmsg) != SQLITE_OK) {
        char err[1024]; snprintf(err, sizeof(err), "{\"error\":\"%s\"}", errmsg ? errmsg : "sqlite error");
        if (errmsg) sqlite3_free(errmsg);
        result = strdup(err);
    } else {
        result = strdup("{\"msg\":\"updated\"}");
    }
    {% endif %}
    cJSON_Delete(json);
    return result;
}

/* ── Helper: ejecutar DELETE desde JSON body ── */
static char *do_delete(const char *body) {
    if (!body || !*body) return strdup("{\"error\":\"empty body\"}");
    cJSON *json = cJSON_Parse(body);
    if (!json) return strdup("{\"error\":\"invalid json\"}");

    cJSON *id_item = cJSON_GetObjectItem(json, "id");
    if (!id_item) { cJSON_Delete(json); return strdup("{\"error\":\"id required\"}"); }

    char id_str[64];
    if (cJSON_IsNumber(id_item)) snprintf(id_str, sizeof(id_str), "%d", id_item->valueint);
    else if (cJSON_IsString(id_item)) snprintf(id_str, sizeof(id_str), "%s", id_item->valuestring);
    else { cJSON_Delete(json); return strdup("{\"error\":\"invalid id\"}"); }

    char *result;
    {% if db == 'postgresql' %}
    const char *paramValues[1] = { id_str };
    PGresult *res = PQexecParams(db_conn, "DELETE FROM data_{{ api_name }} WHERE id = $1", 1, NULL, paramValues, NULL, NULL, 0);
    if (PQresultStatus(res) != PGRES_COMMAND_OK) {
        char err[1024]; snprintf(err, sizeof(err), "{\"error\":\"%s\"}", PQerrorMessage(db_conn));
        result = strdup(err);
    } else {
        result = strdup("{\"msg\":\"deleted\"}");
    }
    PQclear(res);
    {% elif db in ['mysql', 'mariadb'] %}
    char escaped_id[128]; mysql_real_escape_string(db_conn, escaped_id, id_str, strlen(id_str));
    char sql[512]; snprintf(sql, sizeof(sql), "DELETE FROM data_{{ api_name }} WHERE id = '%s'", escaped_id);
    if (mysql_query(db_conn, sql) != 0) {
        char err[1024]; snprintf(err, sizeof(err), "{\"error\":\"%s\"}", mysql_error(db_conn));
        result = strdup(err);
    } else {
        result = strdup("{\"msg\":\"deleted\"}");
    }
    {% elif db == 'sqlite' %}
    char sql[512]; snprintf(sql, sizeof(sql), "DELETE FROM data_{{ api_name }} WHERE id = '%s'", id_str);
    char *errmsg = NULL;
    if (sqlite3_exec(db_conn, sql, NULL, NULL, &errmsg) != SQLITE_OK) {
        char err[1024]; snprintf(err, sizeof(err), "{\"error\":\"%s\"}", errmsg ? errmsg : "sqlite error");
        if (errmsg) sqlite3_free(errmsg);
        result = strdup(err);
    } else {
        result = strdup("{\"msg\":\"deleted\"}");
    }
    {% endif %}
    cJSON_Delete(json);
    return result;
}

static enum MHD_Result handle_request(void *cls, struct MHD_Connection *connection,
    const char *url, const char *method, const char *version,
    const char *upload_data, size_t *upload_data_size, void **con_cls)
{
    struct MHD_Response *response;
    enum MHD_Result ret;

    /* POST body handling */
    if (*con_cls == NULL) {
        struct PostData *pd = calloc(1, sizeof(struct PostData));
        *con_cls = pd;
        return MHD_YES;
    }

    struct PostData *pd = *con_cls;
    if (*upload_data_size > 0) {
        pd->data = realloc(pd->data, pd->size + *upload_data_size + 1);
        memcpy(pd->data + pd->size, upload_data, *upload_data_size);
        pd->size += *upload_data_size;
        pd->data[pd->size] = '\0';
        *upload_data_size = 0;
        return MHD_YES;
    }

    char *resp_str = NULL;

    /* Root endpoint */
    if (strcmp(url, "/") == 0 && strcmp(method, "GET") == 0) {
        resp_str = strdup(json_root);
    }
    {% for endpoint in endpoints %}
    else if (strcmp(url, "{{ endpoint.path }}") == 0 && strcasecmp(method, "{{ endpoint.method | upper }}") == 0) {
        {% if endpoint.logic == 'select' %}
        {% if db == 'postgresql' %}
        PGresult *res = PQexec(db_conn, "SELECT * FROM data_{{ api_name }}");
        int nrows = PQntuples(res);
        int ncols = PQnfields(res);
        size_t buf_size = 4096;
        resp_str = malloc(buf_size);
        strcpy(resp_str, "[");
        for (int i = 0; i < nrows; i++) {
            if (i > 0) strcat(resp_str, ",");
            strcat(resp_str, "{");
            for (int j = 0; j < ncols; j++) {
                if (j > 0) strcat(resp_str, ",");
                char field[512];
                snprintf(field, sizeof(field), "\"%s\":\"%s\"", PQfname(res, j), PQgetvalue(res, i, j));
                if (strlen(resp_str) + strlen(field) + 10 > buf_size) {
                    buf_size *= 2;
                    resp_str = realloc(resp_str, buf_size);
                }
                strcat(resp_str, field);
            }
            strcat(resp_str, "}");
        }
        strcat(resp_str, "]");
        PQclear(res);
        {% elif db in ['mysql', 'mariadb'] %}
        mysql_query(db_conn, "SELECT * FROM data_{{ api_name }}");
        MYSQL_RES *res = mysql_store_result(db_conn);
        int ncols = mysql_num_fields(res);
        MYSQL_FIELD *fields = mysql_fetch_fields(res);
        size_t buf_size = 4096;
        resp_str = malloc(buf_size);
        strcpy(resp_str, "[");
        MYSQL_ROW row;
        int first = 1;
        while ((row = mysql_fetch_row(res))) {
            if (!first) strcat(resp_str, ",");
            first = 0;
            strcat(resp_str, "{");
            for (int j = 0; j < ncols; j++) {
                if (j > 0) strcat(resp_str, ",");
                char field[512];
                snprintf(field, sizeof(field), "\"%s\":\"%s\"", fields[j].name, row[j] ? row[j] : "null");
                if (strlen(resp_str) + strlen(field) + 10 > buf_size) {
                    buf_size *= 2;
                    resp_str = realloc(resp_str, buf_size);
                }
                strcat(resp_str, field);
            }
            strcat(resp_str, "}");
        }
        strcat(resp_str, "]");
        mysql_free_result(res);
        {% elif db == 'sqlite' %}
        sqlite3_stmt *stmt = NULL;
        size_t buf_size = 4096;
        resp_str = malloc(buf_size);
        strcpy(resp_str, "[");
        int first_row = 1;
        if (sqlite3_prepare_v2(db_conn, "SELECT * FROM data_{{ api_name }}", -1, &stmt, NULL) == SQLITE_OK) {
            int ncols = sqlite3_column_count(stmt);
            while (sqlite3_step(stmt) == SQLITE_ROW) {
                if (!first_row) strcat(resp_str, ",");
                first_row = 0;
                strcat(resp_str, "{");
                for (int j = 0; j < ncols; j++) {
                    if (j > 0) strcat(resp_str, ",");
                    const char *cname = sqlite3_column_name(stmt, j);
                    const char *cval = (const char *)sqlite3_column_text(stmt, j);
                    char field[512];
                    snprintf(field, sizeof(field), "\"%s\":\"%s\"", cname, cval ? cval : "null");
                    if (strlen(resp_str) + strlen(field) + 10 > buf_size) {
                        buf_size *= 2;
                        resp_str = realloc(resp_str, buf_size);
                    }
                    strcat(resp_str, field);
                }
                strcat(resp_str, "}");
            }
            sqlite3_finalize(stmt);
        }
        strcat(resp_str, "]");
        {% endif %}
        {% elif endpoint.logic == 'insert' %}
        resp_str = do_insert(pd->data);
        {% elif endpoint.logic == 'update' %}
        resp_str = do_update(pd->data);
        {% elif endpoint.logic == 'delete' %}
        resp_str = do_delete(pd->data);
        {% endif %}
    }
    {% endfor %}
    else {
        resp_str = strdup("{\"error\":\"not found\"}");
    }

    response = MHD_create_response_from_buffer(strlen(resp_str), resp_str, MHD_RESPMEM_MUST_FREE);
    MHD_add_response_header(response, "Content-Type", "application/json");
    ret = MHD_queue_response(connection, MHD_HTTP_OK, response);
    MHD_destroy_response(response);

    if (pd->data) free(pd->data);
    free(pd);
    *con_cls = NULL;

    return ret;
}

int main() {
    init_db();

    struct MHD_Daemon *daemon = MHD_start_daemon(
        MHD_USE_INTERNAL_POLLING_THREAD, PORT,
        NULL, NULL,
        &handle_request, NULL,
        MHD_OPTION_END);

    if (!daemon) {
        fprintf(stderr, "Error iniciando servidor\n");
        return 1;
    }

    printf("API {{ api_name }} running on port %d\n", PORT);
    /* Mantener el proceso vivo */
    pause();

    MHD_stop_daemon(daemon);
    {% if db == 'postgresql' %}
    PQfinish(db_conn);
    {% elif db in ['mysql', 'mariadb'] %}
    mysql_close(db_conn);
    {% elif db == 'sqlite' %}
    sqlite3_close(db_conn);
    {% endif %}
    return 0;
}
