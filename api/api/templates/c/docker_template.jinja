{% if db == 'postgresql' %}{% set build_pkg = 'libpq-dev' %}{% set run_pkg = 'libpq5' %}
{% elif db in ['mysql', 'mariadb'] %}{% set build_pkg = 'default-libmysqlclient-dev' %}{% set run_pkg = 'libmariadb3' %}
{% elif db == 'sqlite' %}{% set build_pkg = 'libsqlite3-dev' %}{% set run_pkg = 'libsqlite3-0' %}
{% endif %}
FROM debian:bookworm-slim AS builder
RUN apt-get update && apt-get install -y \
    gcc make \
    libmicrohttpd-dev \
    libcjson-dev \
    {{ build_pkg }} \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY main.c Makefile ./
RUN make

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y \
    libmicrohttpd12 \
    libcjson1 \
    {{ run_pkg }} \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /api
COPY --from=builder /app/server .
EXPOSE 8000
CMD ["./server"]
