@app.get("/ui/data")
def ui_data():
    with engine.connect() as conn:
        rows = conn.execute(text(f"SELECT * FROM {_UI_TABLE}")).fetchall()
        return [dict(r._mapping) for r in rows]

@app.post("/ui/add")
def ui_add(data: dict = Body(...)):
    with engine.connect() as conn:
        cols = ", ".join(data.keys())
        vals = ", ".join([f":{k}" for k in data.keys()])
        conn.execute(text(f"INSERT INTO {_UI_TABLE} ({cols}) VALUES ({vals})"), data)
        conn.commit()
    return {"ok": True}

@app.put("/ui/update/{row_id}")
def ui_update(row_id: int, data: dict = Body(...)):
    with engine.connect() as conn:
        sets = ", ".join([f"{k} = :{k}" for k in data.keys()])
        params = dict(data)
        params["id"] = row_id
        conn.execute(text(f"UPDATE {_UI_TABLE} SET {sets} WHERE id = :id"), params)
        conn.commit()
    return {"ok": True}

@app.delete("/ui/delete/{row_id}")
def ui_delete(row_id: int):
    with engine.connect() as conn:
        conn.execute(text(f"DELETE FROM {_UI_TABLE} WHERE id = :id"), {"id": row_id})
        conn.commit()
    return {"ok": True}

@app.post("/ui/bulk-delete")
def ui_bulk_delete(ids: list = Body(...)):
    with engine.connect() as conn:
        for id_val in ids:
            conn.execute(text(f"DELETE FROM {_UI_TABLE} WHERE id = :id"), {"id": id_val})
        conn.commit()
    return {"ok": True, "deleted": len(ids)}

{% endif %}
