use actix_web::{web, App, HttpServer, HttpResponse};
use serde::{Deserialize, Serialize};
use serde_json::{json, Value};
use std::env;

{% if db == 'postgresql' %}
use deadpool_postgres::{Manager, Pool, ManagerConfig, RecyclingMethod};
use tokio_postgres::NoTls;

fn get_pool() -> Pool {
    let database_url = env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    let mgr_config = ManagerConfig { recycling_method: RecyclingMethod::Fast };
    let mgr = Manager::from_config(database_url.parse().unwrap(), NoTls, mgr_config);
    Pool::builder(mgr).max_size(16).build().unwrap()
}
{% elif db in ['mysql', 'mariadb'] %}
use mysql_async::prelude::*;
use mysql_async::Pool;

fn get_pool() -> Pool {
    let database_url = env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    let url = database_url.replace("mysql+pymysql://", "mysql://");
    Pool::new(url.as_str())
}
{% elif db == 'sqlite' %}
use rusqlite::{Connection, params};
use std::sync::{Arc, Mutex};

type Pool = Arc<Mutex<Connection>>;

fn get_pool() -> Pool {
    let database_url = env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    let path = database_url.replace("sqlite:///", "");
    let conn = Connection::open(&path).expect("Error abriendo SQLite");
    Arc::new(Mutex::new(conn))
}
{% endif %}

#[derive(Serialize, Deserialize)]
struct GenericBody {
    #[serde(flatten)]
    fields: std::collections::HashMap<String, Value>,
}

async fn root() -> HttpResponse {
    HttpResponse::Ok().json(json!({"status": "online", "api": "{{ api_name }}"}))
}

{% for endpoint in endpoints %}
{% if endpoint.logic == 'select' %}
async fn {{ endpoint.function_name }}(
    pool: web::Data<Pool>,
) -> HttpResponse {
    {% if db == 'postgresql' %}
    let client = pool.get().await.unwrap();
    match client.query("SELECT * FROM data_{{ api_name }}", &[]).await {
        Ok(rows) => {
            let columns: Vec<String> = rows.first()
                .map(|r| r.columns().iter().map(|c| c.name().to_string()).collect())
                .unwrap_or_default();
            let results: Vec<std::collections::HashMap<String, Value>> = rows.iter().map(|row| {
                let mut map = std::collections::HashMap::new();
                for (i, col) in columns.iter().enumerate() {
                    if let Ok(v) = row.try_get::<_, i32>(i) {
                        map.insert(col.clone(), json!(v));
                    } else if let Ok(v) = row.try_get::<_, String>(i) {
                        map.insert(col.clone(), json!(v));
                    } else if let Ok(v) = row.try_get::<_, f64>(i) {
                        map.insert(col.clone(), json!(v));
                    } else if let Ok(v) = row.try_get::<_, bool>(i) {
                        map.insert(col.clone(), json!(v));
                    }
                }
                map
            }).collect();
            HttpResponse::Ok().json(results)
        }
        Err(e) => HttpResponse::InternalServerError().json(json!({"error": e.to_string()})),
    }
    {% elif db in ['mysql', 'mariadb'] %}
    let mut conn = pool.get_conn().await.unwrap();
    let rows: Vec<mysql_async::Row> = conn.query("SELECT * FROM data_{{ api_name }}").await.unwrap();
    let results: Vec<std::collections::HashMap<String, Value>> = rows.iter().map(|row| {
        let mut map = std::collections::HashMap::new();
        for i in 0..row.len() {
            let col_name = row.columns_ref()[i].name_str().to_string();
            let val: Option<String> = row.get(i);
            map.insert(col_name, json!(val.unwrap_or_default()));
        }
        map
    }).collect();
    HttpResponse::Ok().json(results)
    {% elif db == 'sqlite' %}
    let conn = pool.lock().unwrap();
    let mut stmt = conn.prepare("SELECT * FROM data_{{ api_name }}").unwrap();
    let col_names: Vec<String> = stmt.column_names().iter().map(|s| s.to_string()).collect();
    let results: Vec<std::collections::HashMap<String, Value>> = stmt.query_map([], |row| {
        let mut map = std::collections::HashMap::new();
        for (i, col) in col_names.iter().enumerate() {
            let v: rusqlite::types::Value = row.get(i).unwrap_or(rusqlite::types::Value::Null);
            let jv = match v {
                rusqlite::types::Value::Integer(n) => json!(n),
                rusqlite::types::Value::Real(f) => json!(f),
                rusqlite::types::Value::Text(s) => json!(s),
                _ => json!(null),
            };
            map.insert(col.clone(), jv);
        }
        Ok(map)
    }).unwrap().filter_map(|r| r.ok()).collect();
    HttpResponse::Ok().json(results)
    {% endif %}
}
{% elif endpoint.logic == 'insert' %}
async fn {{ endpoint.function_name }}(
    body: web::Json<GenericBody>,
    pool: web::Data<Pool>,
) -> HttpResponse {
    let fields = &body.fields;
    let keys: Vec<&String> = fields.keys().collect();
    let cols = keys.iter().map(|k| k.as_str()).collect::<Vec<_>>().join(", ");
    {% if db == 'postgresql' %}
    let placeholders: Vec<String> = (1..=keys.len()).map(|i| format!("${}", i)).collect();
    let sql = format!("INSERT INTO data_{{ api_name }} ({}) VALUES ({})", cols, placeholders.join(", "));
    let client = pool.get().await.unwrap();
    let values: Vec<String> = fields.values().map(|v| v.as_str().unwrap_or("").to_string()).collect();
    let params: Vec<&(dyn tokio_postgres::types::ToSql + Sync)> = values.iter().map(|v| v as &(dyn tokio_postgres::types::ToSql + Sync)).collect();
    match client.execute(&sql, &params).await {
        Ok(_) => HttpResponse::Ok().json(json!({"msg": "inserted"})),
        Err(e) => HttpResponse::InternalServerError().json(json!({"error": e.to_string()})),
    }
    {% elif db in ['mysql', 'mariadb'] %}
    let placeholders = vec!["?"; keys.len()].join(", ");
    let sql = format!("INSERT INTO data_{{ api_name }} ({}) VALUES ({})", cols, placeholders);
    let mut conn = pool.get_conn().await.unwrap();
    let values: Vec<String> = fields.values().map(|v| v.as_str().unwrap_or("").to_string()).collect();
    match conn.exec_drop(&sql, values).await {
        Ok(_) => HttpResponse::Ok().json(json!({"msg": "inserted"})),
        Err(e) => HttpResponse::InternalServerError().json(json!({"error": e.to_string()})),
    }
    {% elif db == 'sqlite' %}
    let placeholders = vec!["?"; keys.len()].join(", ");
    let sql = format!("INSERT INTO data_{{ api_name }} ({}) VALUES ({})", cols, placeholders);
    let conn = pool.lock().unwrap();
    let values: Vec<String> = fields.values().map(|v| v.as_str().unwrap_or("").to_string()).collect();
    let p: Vec<&dyn rusqlite::types::ToSql> = values.iter().map(|v| v as &dyn rusqlite::types::ToSql).collect();
    match conn.execute(&sql, p.as_slice()) {
        Ok(_) => HttpResponse::Ok().json(json!({"msg": "inserted"})),
        Err(e) => HttpResponse::InternalServerError().json(json!({"error": e.to_string()})),
    }
    {% endif %}
}
{% elif endpoint.logic == 'update' %}
async fn {{ endpoint.function_name }}(
    body: web::Json<GenericBody>,
    pool: web::Data<Pool>,
) -> HttpResponse {
    let mut fields = body.fields.clone();
    let id = fields.remove("id").unwrap_or(json!(0));
    {% if db == 'postgresql' %}
    let sets: Vec<String> = fields.keys().enumerate().map(|(i, k)| format!("{} = ${}", k, i + 1)).collect();
    let sql = format!("UPDATE data_{{ api_name }} SET {} WHERE id = ${}", sets.join(", "), fields.len() + 1);
    let client = pool.get().await.unwrap();
    let mut values: Vec<String> = fields.values().map(|v| v.as_str().unwrap_or("").to_string()).collect();
    values.push(id.to_string().trim_matches('"').to_string());
    let params: Vec<&(dyn tokio_postgres::types::ToSql + Sync)> = values.iter().map(|v| v as &(dyn tokio_postgres::types::ToSql + Sync)).collect();
    match client.execute(&sql, &params).await {
        Ok(_) => HttpResponse::Ok().json(json!({"msg": "updated"})),
        Err(e) => HttpResponse::InternalServerError().json(json!({"error": e.to_string()})),
    }
    {% elif db in ['mysql', 'mariadb'] %}
    let sets: Vec<String> = fields.keys().map(|k| format!("{} = ?", k)).collect();
    let sql = format!("UPDATE data_{{ api_name }} SET {} WHERE id = ?", sets.join(", "));
    let mut conn = pool.get_conn().await.unwrap();
    let mut values: Vec<String> = fields.values().map(|v| v.as_str().unwrap_or("").to_string()).collect();
    values.push(id.to_string().trim_matches('"').to_string());
    match conn.exec_drop(&sql, values).await {
        Ok(_) => HttpResponse::Ok().json(json!({"msg": "updated"})),
        Err(e) => HttpResponse::InternalServerError().json(json!({"error": e.to_string()})),
    }
    {% elif db == 'sqlite' %}
    let sets: Vec<String> = fields.keys().map(|k| format!("{} = ?", k)).collect();
    let sql = format!("UPDATE data_{{ api_name }} SET {} WHERE id = ?", sets.join(", "));
    let conn = pool.lock().unwrap();
    let mut values: Vec<String> = fields.values().map(|v| v.as_str().unwrap_or("").to_string()).collect();
    values.push(id.to_string().trim_matches('"').to_string());
    let p: Vec<&dyn rusqlite::types::ToSql> = values.iter().map(|v| v as &dyn rusqlite::types::ToSql).collect();
    match conn.execute(&sql, p.as_slice()) {
        Ok(_) => HttpResponse::Ok().json(json!({"msg": "updated"})),
        Err(e) => HttpResponse::InternalServerError().json(json!({"error": e.to_string()})),
    }
    {% endif %}
}
{% elif endpoint.logic == 'delete' %}
async fn {{ endpoint.function_name }}(
    body: web::Json<GenericBody>,
    pool: web::Data<Pool>,
) -> HttpResponse {
    let id = body.fields.get("id").unwrap_or(&json!(0));
    {% if db == 'postgresql' %}
    let id_str = id.to_string().trim_matches('"').to_string();
    let client = pool.get().await.unwrap();
    match client.execute("DELETE FROM data_{{ api_name }} WHERE id = $1", &[&id_str]).await {
        Ok(_) => HttpResponse::Ok().json(json!({"msg": "deleted"})),
        Err(e) => HttpResponse::InternalServerError().json(json!({"error": e.to_string()})),
    }
    {% elif db in ['mysql', 'mariadb'] %}
    let id_str = id.to_string().trim_matches('"').to_string();
    let mut conn = pool.get_conn().await.unwrap();
    match conn.exec_drop("DELETE FROM data_{{ api_name }} WHERE id = ?", (id_str,)).await {
        Ok(_) => HttpResponse::Ok().json(json!({"msg": "deleted"})),
        Err(e) => HttpResponse::InternalServerError().json(json!({"error": e.to_string()})),
    }
    {% elif db == 'sqlite' %}
    let id_str = id.to_string().trim_matches('"').to_string();
    let conn = pool.lock().unwrap();
    match conn.execute("DELETE FROM data_{{ api_name }} WHERE id = ?1", rusqlite::params![id_str]) {
        Ok(_) => HttpResponse::Ok().json(json!({"msg": "deleted"})),
        Err(e) => HttpResponse::InternalServerError().json(json!({"error": e.to_string()})),
    }
    {% endif %}
}
{% endif %}
{% endfor %}

#[actix_web::main]
async fn main() -> std::io::Result<()> {
    let pool = get_pool();

    HttpServer::new(move || {
        let app = App::new()
            .app_data(web::Data::new(pool.clone()))
            .route("/", web::get().to(root))
            {% for endpoint in endpoints %}
            .route("{{ endpoint.path }}", web::{{ endpoint.method | lower }}().to({{ endpoint.function_name }}))
            {% endfor %};
        app
    })
    .bind("0.0.0.0:8000")?
    .run()
    .await
}

