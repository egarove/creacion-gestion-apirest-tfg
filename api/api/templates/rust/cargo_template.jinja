[package]
name = "api-{{ api_name }}"
version = "0.1.0"
edition = "2021"

[dependencies]
actix-web = "4"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tokio = { version = "1", features = ["full"] }
{% if db == 'postgresql' %}
tokio-postgres = "0.7"
{% elif db in ['mysql', 'mariadb'] %}
mysql_async = "0.33"
{% endif %}
