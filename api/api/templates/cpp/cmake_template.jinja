cmake_minimum_required(VERSION 3.14)
project(api-{{ api_name }})

set(CMAKE_CXX_STANDARD 17)

include(FetchContent)
FetchContent_Declare(
    crow
    GIT_REPOSITORY https://github.com/CrowCpp/Crow.git
    GIT_TAG v1.1.0
)
FetchContent_MakeAvailable(crow)

add_executable(server main.cpp)
target_link_libraries(server PRIVATE Crow::Crow)

{% if db == 'postgresql' %}
find_package(PostgreSQL REQUIRED)
target_link_libraries(server PRIVATE PostgreSQL::PostgreSQL)
{% elif db in ['mysql', 'mariadb'] %}
find_package(PkgConfig REQUIRED)
pkg_check_modules(MYSQL REQUIRED mysqlclient)
target_include_directories(server PRIVATE ${MYSQL_INCLUDE_DIRS})
target_link_libraries(server PRIVATE ${MYSQL_LIBRARIES})
{% endif %}
