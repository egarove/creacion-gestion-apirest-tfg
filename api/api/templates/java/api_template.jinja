package com.api;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.web.bind.annotation.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.http.ResponseEntity;
{% if db == 'sqlite' %}
import jakarta.annotation.PostConstruct;
{% endif %}

import java.util.*;
import java.util.StringJoiner;

@SpringBootApplication
@RestController
public class App {

    @Autowired
    private JdbcTemplate jdbc;

    public static void main(String[] args) {
        SpringApplication.run(App.class, args);
    }

    {% if db == 'sqlite' %}
    @PostConstruct
    public void initDb() {
        jdbc.execute("CREATE TABLE IF NOT EXISTS data_{{ api_name }} (id INTEGER PRIMARY KEY AUTOINCREMENT, {% for col in columns %}{{ col }}{% if not loop.last %}, {% endif %}{% endfor %})");
    }
    {% endif %}

    @GetMapping("/")
    public Map<String, String> root() {
        Map<String, String> res = new HashMap<>();
        res.put("status", "online");
        res.put("api", "{{ api_name }}");
        return res;
    }

    {% for endpoint in endpoints %}
    {% if endpoint.method == 'get' %}
    @GetMapping("{{ endpoint.path }}")
    {% elif endpoint.method == 'post' %}
    @PostMapping("{{ endpoint.path }}")
    {% elif endpoint.method == 'put' %}
    @PutMapping("{{ endpoint.path }}")
    {% elif endpoint.method == 'delete' %}
    @DeleteMapping("{{ endpoint.path }}")
    {% endif %}
    public ResponseEntity<?> {{ endpoint.function_name }}(
        {% if '{id}' in endpoint.path %}
        @PathVariable(name = "id", required = false) String pathId,
        {% endif %}
        {% if endpoint.logic != 'select' %}
        @RequestBody(required = false) Map<String, Object> body
        {% endif %}
    ) {
        try {
            {% if endpoint.logic == 'select' %}
            List<Map<String, Object>> rows = jdbc.queryForList("SELECT * FROM data_{{ api_name }}");
            return ResponseEntity.ok(rows);
            {% elif endpoint.logic == 'insert' %}
            if (body == null || body.isEmpty()) {
                return ResponseEntity.badRequest().body(Map.of("error", "Body vacío"));
            }
            StringJoiner cols = new StringJoiner(", ");
            StringJoiner placeholders = new StringJoiner(", ");
            List<Object> values = new ArrayList<>();
            for (Map.Entry<String, Object> entry : body.entrySet()) {
                cols.add(entry.getKey());
                placeholders.add("?");
                values.add(entry.getValue());
            }
            String sql = String.format("INSERT INTO data_{{ api_name }} (%s) VALUES (%s)", cols, placeholders);
            jdbc.update(sql, values.toArray());
            return ResponseEntity.ok(Map.of("msg", "inserted"));
            {% elif endpoint.logic == 'update' %}
            Object id = {% if '{id}' in endpoint.path %}pathId != null ? pathId : {% endif %}(body != null ? body.get("id") : null);
            if (id == null) {
                return ResponseEntity.badRequest().body(Map.of("error", "Se requiere id"));
            }
            if (body != null) body.remove("id");
            StringJoiner sets = new StringJoiner(", ");
            List<Object> values = new ArrayList<>();
            for (Map.Entry<String, Object> entry : (body != null ? body : Map.<String,Object>of()).entrySet()) {
                sets.add(entry.getKey() + " = ?");
                values.add(entry.getValue());
            }
            values.add(id);
            String sql = String.format("UPDATE data_{{ api_name }} SET %s WHERE id = ?", sets);
            jdbc.update(sql, values.toArray());
            return ResponseEntity.ok(Map.of("msg", "updated"));
            {% elif endpoint.logic == 'delete' %}
            Object id = {% if '{id}' in endpoint.path %}pathId != null ? pathId : {% endif %}(body != null ? body.get("id") : null);
            if (id == null) {
                return ResponseEntity.badRequest().body(Map.of("error", "Se requiere id"));
            }
            jdbc.update("DELETE FROM data_{{ api_name }} WHERE id = ?", id);
            return ResponseEntity.ok(Map.of("msg", "deleted"));
            {% endif %}
        } catch (Exception e) {
            return ResponseEntity.status(500).body(Map.of("error", e.getMessage()));
        }
    }
    {% endfor %}
}
