{% if db == 'postgresql' %}
spring.datasource.url=jdbc:postgresql://${DATABASE_URL_HOST:localhost:5432}/${DATABASE_URL_DB:{{ api_name }}_db}
spring.datasource.username=${DATABASE_URL_USER:user}
spring.datasource.password=${DATABASE_URL_PASS:password}
spring.datasource.driver-class-name=org.postgresql.Driver
{% elif db in ['mysql', 'mariadb'] %}
spring.datasource.url=jdbc:mysql://${DATABASE_URL_HOST:localhost:3306}/${DATABASE_URL_DB:{{ api_name }}_db}
spring.datasource.username=${DATABASE_URL_USER:user}
spring.datasource.password=${DATABASE_URL_PASS:password}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
{% elif db == 'sqlite' %}
spring.datasource.url=jdbc:sqlite:{{ api_name }}.db
spring.datasource.driver-class-name=org.sqlite.JDBC
{% endif %}
server.port=8000
