{% if db == 'postgresql' %}
spring.datasource.url=jdbc:postgresql://${DB_HOST:postgres}:${DB_PORT:5432}/${DB_NAME:{{ api_name }}_db}
spring.datasource.username=${DB_USER:user}
spring.datasource.password=${DB_PASS:password}
spring.datasource.driver-class-name=org.postgresql.Driver
{% elif db in ['mysql', 'mariadb'] %}
spring.datasource.url=jdbc:mysql://${DB_HOST:{{ db }}}:${DB_PORT:3306}/${DB_NAME:{{ api_name }}_db}
spring.datasource.username=${DB_USER:user}
spring.datasource.password=${DB_PASS:password}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
{% elif db == 'sqlite' %}
spring.datasource.url=jdbc:sqlite:{{ api_name }}.db
spring.datasource.driver-class-name=org.sqlite.JDBC
spring.datasource.username=
spring.datasource.password=
{% endif %}
server.port=8000

