{% if db == 'postgresql' %}{% set build_pkg = 'libpq-dev' %}{% set run_pkg = 'libpq5' %}
{% elif db in ['mysql', 'mariadb'] %}{% set build_pkg = 'default-libmysqlclient-dev' %}{% set run_pkg = 'libmariadb3' %}
{% elif db == 'sqlite' %}{% set build_pkg = 'libsqlite3-dev' %}{% set run_pkg = 'libsqlite3-0' %}
{% endif %}
FROM debian:bookworm-slim AS builder
RUN apt-get update && apt-get install -y \
    g++ cmake git pkg-config \
    libboost-all-dev libasio-dev \
    {{ build_pkg }} \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY CMakeLists.txt main.cpp ./
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y \
    {{ run_pkg }} \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /api
COPY --from=builder /app/build/server .
EXPOSE 8000
CMD ["./server"]
