#include "crow.h"
#include <string>
#include <sstream>
#include <cstdlib>
#include <vector>
{% if db == 'postgresql' %}
#include <libpq-fe.h>
{% elif db in ['mysql', 'mariadb'] %}
#include <mysql/mysql.h>
{% elif db == 'sqlite' %}
#include <sqlite3.h>
{% endif %}

{% if db == 'postgresql' %}
static PGconn* db_conn = nullptr;

void init_db() {
    const char* url = std::getenv("DATABASE_URL");
    db_conn = PQconnectdb(url ? url : "");
    if (PQstatus(db_conn) != CONNECTION_OK) {
        std::cerr << "Error conexion BD: " << PQerrorMessage(db_conn) << std::endl;
        std::exit(1);
    }
}
{% elif db in ['mysql', 'mariadb'] %}
static MYSQL* db_conn = nullptr;

void init_db() {
    const char* url = std::getenv("DATABASE_URL");
    db_conn = mysql_init(nullptr);
    char user[64] = {}, pass[64] = {}, host[128] = {}, dbname[64] = {};
    int port = 3306;
    sscanf(url, "%*[^/]//%63[^:]:%63[^@]@%127[^:]:%d/%63s", user, pass, host, &port, dbname);
    if (!mysql_real_connect(db_conn, host, user, pass, dbname, port, nullptr, 0)) {
        std::cerr << "Error conexion BD: " << mysql_error(db_conn) << std::endl;
        std::exit(1);
    }
}
{% elif db == 'sqlite' %}
static sqlite3* db_conn = nullptr;

void init_db() {
    const char* url = std::getenv("DATABASE_URL");
    std::string path(url ? url : "data.db");
    if (path.find("sqlite:///") == 0) path = path.substr(10);
    if (sqlite3_open(path.c_str(), &db_conn) != SQLITE_OK) {
        std::cerr << "Error abriendo BD: " << sqlite3_errmsg(db_conn) << std::endl;
        std::exit(1);
    }
    sqlite3_exec(db_conn, "CREATE TABLE IF NOT EXISTS data_{{ api_name }} (id INTEGER PRIMARY KEY AUTOINCREMENT, {% for col in columns %}{{ col }}{% if not loop.last %}, {% endif %}{% endfor %})", nullptr, nullptr, nullptr);
}
{% endif %}

{% if db in ['mysql', 'mariadb'] %}
/* Helper: escapar string para MySQL */
static std::string mysql_escape(const std::string& s) {
    std::vector<char> buf(s.size() * 2 + 1);
    mysql_real_escape_string(db_conn, buf.data(), s.c_str(), s.size());
    return std::string(buf.data());
}
{% endif %}

int main() {
    init_db();
    crow::SimpleApp app;

    CROW_ROUTE(app, "/").methods(crow::HTTPMethod::GET)([]() {
        crow::json::wvalue res;
        res["status"] = "online";
        res["api"] = "{{ api_name }}";
        return res;
    });

    {% for endpoint in endpoints %}
    CROW_ROUTE(app, "{{ endpoint.path | replace('{id}', '<string>') }}").methods(crow::HTTPMethod::{{ endpoint.method | upper }})(
        {% if '{id}' in endpoint.path %}
        [](const crow::request& req, std::string path_id) {
        {% else %}
        []({% if endpoint.logic != 'select' %}const crow::request& req{% endif %}) {
        {% endif %}
        {% if endpoint.logic == 'select' %}
        {% if db == 'postgresql' %}
        PGresult* res = PQexec(db_conn, "SELECT * FROM data_{{ api_name }}");
        int nrows = PQntuples(res);
        int ncols = PQnfields(res);
        crow::json::wvalue::list result;
        for (int i = 0; i < nrows; i++) {
            crow::json::wvalue row;
            for (int j = 0; j < ncols; j++) {
                row[PQfname(res, j)] = PQgetvalue(res, i, j);
            }
            result.push_back(std::move(row));
        }
        PQclear(res);
        return crow::json::wvalue(std::move(result));
        {% elif db in ['mysql', 'mariadb'] %}
        mysql_query(db_conn, "SELECT * FROM data_{{ api_name }}");
        MYSQL_RES* res = mysql_store_result(db_conn);
        int ncols = mysql_num_fields(res);
        MYSQL_FIELD* fields = mysql_fetch_fields(res);
        crow::json::wvalue::list result;
        MYSQL_ROW row;
        while ((row = mysql_fetch_row(res))) {
            crow::json::wvalue r;
            for (int j = 0; j < ncols; j++) {
                r[fields[j].name] = row[j] ? row[j] : "";
            }
            result.push_back(std::move(r));
        }
        mysql_free_result(res);
        return crow::json::wvalue(std::move(result));
        {% elif db == 'sqlite' %}
        crow::json::wvalue::list result;
        sqlite3_stmt* stmt = nullptr;
        if (sqlite3_prepare_v2(db_conn, "SELECT * FROM data_{{ api_name }}", -1, &stmt, nullptr) == SQLITE_OK) {
            int ncols = sqlite3_column_count(stmt);
            while (sqlite3_step(stmt) == SQLITE_ROW) {
                crow::json::wvalue row;
                for (int j = 0; j < ncols; j++) {
                    const char* name = sqlite3_column_name(stmt, j);
                    const char* val = (const char*)sqlite3_column_text(stmt, j);
                    row[name] = val ? val : "";
                }
                result.push_back(std::move(row));
            }
            sqlite3_finalize(stmt);
        }
        return crow::json::wvalue(std::move(result));
        {% endif %}
        {% elif endpoint.logic == 'insert' %}
        auto body = crow::json::load(req.body);
        if (!body) {
            crow::json::wvalue err; err["error"] = "invalid json";
            return err;
        }
        std::ostringstream cols_ss, vals_ss;
        {% if db == 'postgresql' %}
        std::vector<std::string> paramStrs;
        int idx = 0;
        for (auto& kv : body) {
            if (idx > 0) { cols_ss << ", "; vals_ss << ", "; }
            cols_ss << kv.key();
            vals_ss << "$" << (idx + 1);
            paramStrs.push_back(std::string(kv));
            idx++;
        }
        std::string sql = "INSERT INTO data_{{ api_name }} (" + cols_ss.str() + ") VALUES (" + vals_ss.str() + ")";
        std::vector<const char*> paramValues;
        for (auto& s : paramStrs) paramValues.push_back(s.c_str());
        PGresult* res = PQexecParams(db_conn, sql.c_str(), idx, nullptr, paramValues.data(), nullptr, nullptr, 0);
        crow::json::wvalue resp;
        if (PQresultStatus(res) != PGRES_COMMAND_OK) {
            resp["error"] = PQerrorMessage(db_conn);
        } else {
            resp["msg"] = "inserted";
        }
        PQclear(res);
        return resp;
        {% elif db in ['mysql', 'mariadb'] %}
        int idx = 0;
        for (auto& kv : body) {
            if (idx > 0) { cols_ss << ", "; vals_ss << ", "; }
            cols_ss << kv.key();
            vals_ss << "'" << mysql_escape(std::string(kv)) << "'";
            idx++;
        }
        std::string sql = "INSERT INTO data_{{ api_name }} (" + cols_ss.str() + ") VALUES (" + vals_ss.str() + ")";
        crow::json::wvalue resp;
        if (mysql_query(db_conn, sql.c_str()) != 0) {
            resp["error"] = mysql_error(db_conn);
        } else {
            resp["msg"] = "inserted";
        }
        return resp;
        {% elif db == 'sqlite' %}
        int idx = 0;
        for (auto& kv : body) {
            if (idx > 0) { cols_ss << ", "; vals_ss << ", "; }
            cols_ss << kv.key();
            vals_ss << "'" << std::string(kv) << "'";
            idx++;
        }
        std::string sql = "INSERT INTO data_{{ api_name }} (" + cols_ss.str() + ") VALUES (" + vals_ss.str() + ")";
        crow::json::wvalue resp;
        char* errmsg = nullptr;
        if (sqlite3_exec(db_conn, sql.c_str(), nullptr, nullptr, &errmsg) != SQLITE_OK) {
            resp["error"] = errmsg ? errmsg : "sqlite error";
            if (errmsg) sqlite3_free(errmsg);
        } else {
            resp["msg"] = "inserted";
        }
        return resp;
        {% endif %}
        {% elif endpoint.logic == 'update' %}
        auto body = crow::json::load(req.body);
        if (!body) {
            crow::json::wvalue err; err["error"] = "invalid json";
            return err;
        }
        std::string id_val;
        {% if '{id}' in endpoint.path %}
        id_val = path_id;
        {% else %}
        if (body.has("id")) id_val = std::string(body["id"]);
        if (id_val.empty()) {
            crow::json::wvalue err; err["error"] = "id required";
            return err;
        }
        {% endif %}
        std::ostringstream sets_ss;
        {% if db == 'postgresql' %}
        std::vector<std::string> paramStrs;
        int idx = 0;
        for (auto& kv : body) {
            if (kv.key() == "id") continue;
            if (idx > 0) sets_ss << ", ";
            sets_ss << kv.key() << " = $" << (idx + 1);
            paramStrs.push_back(std::string(kv));
            idx++;
        }
        paramStrs.push_back(id_val);
        std::string sql = "UPDATE data_{{ api_name }} SET " + sets_ss.str() + " WHERE id = $" + std::to_string(idx + 1);
        std::vector<const char*> paramValues;
        for (auto& s : paramStrs) paramValues.push_back(s.c_str());
        PGresult* res = PQexecParams(db_conn, sql.c_str(), idx + 1, nullptr, paramValues.data(), nullptr, nullptr, 0);
        crow::json::wvalue resp;
        if (PQresultStatus(res) != PGRES_COMMAND_OK) {
            resp["error"] = PQerrorMessage(db_conn);
        } else {
            resp["msg"] = "updated";
        }
        PQclear(res);
        return resp;
        {% elif db in ['mysql', 'mariadb'] %}
        int idx = 0;
        for (auto& kv : body) {
            if (kv.key() == "id") continue;
            if (idx > 0) sets_ss << ", ";
            sets_ss << kv.key() << " = '" << mysql_escape(std::string(kv)) << "'";
            idx++;
        }
        std::string sql = "UPDATE data_{{ api_name }} SET " + sets_ss.str() + " WHERE id = '" + mysql_escape(id_val) + "'";
        crow::json::wvalue resp;
        if (mysql_query(db_conn, sql.c_str()) != 0) {
            resp["error"] = mysql_error(db_conn);
        } else {
            resp["msg"] = "updated";
        }
        return resp;
        {% elif db == 'sqlite' %}
        int idx = 0;
        for (auto& kv : body) {
            if (kv.key() == "id") continue;
            if (idx > 0) sets_ss << ", ";
            sets_ss << kv.key() << " = '" << std::string(kv) << "'";
            idx++;
        }
        std::string sql = "UPDATE data_{{ api_name }} SET " + sets_ss.str() + " WHERE id = '" + id_val + "'";
        crow::json::wvalue resp;
        char* errmsg = nullptr;
        if (sqlite3_exec(db_conn, sql.c_str(), nullptr, nullptr, &errmsg) != SQLITE_OK) {
            resp["error"] = errmsg ? errmsg : "sqlite error";
            if (errmsg) sqlite3_free(errmsg);
        } else {
            resp["msg"] = "updated";
        }
        return resp;
        {% endif %}
        {% elif endpoint.logic == 'delete' %}
        auto body = crow::json::load(req.body);
        if (!body) {
            crow::json::wvalue err; err["error"] = "invalid json";
            return err;
        }
        std::string id_val;
        {% if '{id}' in endpoint.path %}
        id_val = path_id;
        {% else %}
        if (body.has("id")) id_val = std::string(body["id"]);
        if (id_val.empty()) {
            crow::json::wvalue err; err["error"] = "id required";
            return err;
        }
        {% endif %}
        {% if db == 'postgresql' %}
        const char* paramValues[1] = { id_val.c_str() };
        PGresult* res = PQexecParams(db_conn, "DELETE FROM data_{{ api_name }} WHERE id = $1", 1, nullptr, paramValues, nullptr, nullptr, 0);
        crow::json::wvalue resp;
        if (PQresultStatus(res) != PGRES_COMMAND_OK) {
            resp["error"] = PQerrorMessage(db_conn);
        } else {
            resp["msg"] = "deleted";
        }
        PQclear(res);
        return resp;
        {% elif db in ['mysql', 'mariadb'] %}
        std::string sql = "DELETE FROM data_{{ api_name }} WHERE id = '" + mysql_escape(id_val) + "'";
        crow::json::wvalue resp;
        if (mysql_query(db_conn, sql.c_str()) != 0) {
            resp["error"] = mysql_error(db_conn);
        } else {
            resp["msg"] = "deleted";
        }
        return resp;
        {% elif db == 'sqlite' %}
        std::string sql = "DELETE FROM data_{{ api_name }} WHERE id = '" + id_val + "'";
        crow::json::wvalue resp;
        char* errmsg = nullptr;
        if (sqlite3_exec(db_conn, sql.c_str(), nullptr, nullptr, &errmsg) != SQLITE_OK) {
            resp["error"] = errmsg ? errmsg : "sqlite error";
            if (errmsg) sqlite3_free(errmsg);
        } else {
            resp["msg"] = "deleted";
        }
        return resp;
        {% endif %}
        {% endif %}
    });
    {% endfor %}

    app.port(8000).bindaddr("0.0.0.0").multithreaded().run();

    {% if db == 'postgresql' %}
    PQfinish(db_conn);
    {% elif db in ['mysql', 'mariadb'] %}
    mysql_close(db_conn);
    {% elif db == 'sqlite' %}
    sqlite3_close(db_conn);
    {% endif %}
    return 0;
}

