const express = require('express');
{% if db == 'postgresql' %}
const { Pool } = require('pg');
{% elif db in ['mysql', 'mariadb'] %}
const mysql = require('mysql2/promise');
{% endif %}

const app = express();
app.use(express.json());

const DATABASE_URL = process.env.DATABASE_URL;

{% if db == 'postgresql' %}
const pool = new Pool({ connectionString: DATABASE_URL });

async function query(sql, params) {
    const client = await pool.connect();
    try {
        const res = await client.query(sql, params);
        return res.rows;
    } finally {
        client.release();
    }
}
{% elif db in ['mysql', 'mariadb'] %}
let pool;
(async () => {
    const url = DATABASE_URL.replace('mysql+pymysql://', 'mysql://');
    pool = await mysql.createPool(url);
})();

async function query(sql, params) {
    const [rows] = await pool.execute(sql, params);
    return rows;
}
{% elif db == 'sqlite' %}
const Database = require('better-sqlite3');
const db_conn = new Database(DATABASE_URL.replace('sqlite:///', ''));
db_conn.prepare("CREATE TABLE IF NOT EXISTS data_{{ api_name }} (id INTEGER PRIMARY KEY AUTOINCREMENT, {% for col in columns %}{{ col }}{% if not loop.last %}, {% endif %}{% endfor %})").run();

function query(sql, params) {
    if (sql.trim().toUpperCase().startsWith('SELECT')) {
        return db_conn.prepare(sql).all(...(params || []));
    } else {
        return db_conn.prepare(sql).run(...(params || []));
    }
}
{% endif %}

app.get('/', (req, res) => {
    res.json({ status: 'online', api: '{{ api_name }}' });
});

{% for endpoint in endpoints %}
{% set _tbl = endpoint.table if endpoint.table else 'data_' ~ api_name %}
app.{{ endpoint.method | lower }}('{{ endpoint.path | replace("{", ":") | replace("}", "") }}', async (req, res) => {
    try {
        {% if endpoint.logic == 'select' %}
        const rows = await query('SELECT * FROM {{ _tbl }}');
        res.json(rows);
        {% elif endpoint.logic == 'insert' %}
        const body = req.body;
        const keys = Object.keys(body);
        const values = Object.values(body);
        {% if db == 'postgresql' %}
        const placeholders = keys.map((_, i) => `$${i + 1}`).join(', ');
        {% else %}
        const placeholders = keys.map(() => '?').join(', ');
        {% endif %}
        const sql = `INSERT INTO {{ _tbl }} (${keys.join(', ')}) VALUES (${placeholders})`;
        await query(sql, values);
        res.json({ msg: 'inserted' });
        {% elif endpoint.logic == 'update' %}
        const body = req.body;
        const id = req.params.id || body.id;
        const keys = Object.keys(body).filter(k => k !== 'id');
        const values = Object.values(body).filter((_, i) => Object.keys(body)[i] !== 'id');
        {% if db == 'postgresql' %}
        const sets = keys.map((k, i) => `${k} = $${i + 1}`).join(', ');
        values.push(id);
        const sql = `UPDATE {{ _tbl }} SET ${sets} WHERE id = $${values.length}`;
        {% else %}
        const sets = keys.map(k => `${k} = ?`).join(', ');
        values.push(id);
        const sql = `UPDATE {{ _tbl }} SET ${sets} WHERE id = ?`;
        {% endif %}
        await query(sql, values);
        res.json({ msg: 'updated' });
        {% elif endpoint.logic == 'delete' %}
        const id = req.params.id || req.body.id;
        {% if db == 'postgresql' %}
        await query('DELETE FROM {{ _tbl }} WHERE id = $1', [id]);
        {% else %}
        await query('DELETE FROM {{ _tbl }} WHERE id = ?', [id]);
        {% endif %}
        res.json({ msg: 'deleted' });
        {% endif %}
    } catch (err) {
        res.status(500).json({ error: err.message });
    }
});
{% endfor %}

app.listen(8000, '0.0.0.0', () => {
    console.log('API {{ api_name }} running on port 8000');
});
